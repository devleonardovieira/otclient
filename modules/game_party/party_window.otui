PartyListRow < Panel
  height: 40
  margin-left: -10
  layout: horizontalBox
  
  UIWidget
    id: statusIcon
    width: 10
    height: 10
    margin-top: 15
    margin-right: 10
    background-color: #00ff00

  UIWidget
    id: leaderIcon
    width: 16
    height: 16
    margin-top: 12
    margin-right: 5
    image-source: /images/game/party_leader_icon
    visible: false

  Label
    id: name
    width: 280
    height: 40
    text-auto-resize: false
    text-align: left
    text-offset: 0 0
    color: white
    font: verdana-11px-rounded

  ButtonRedBase
    id: actionButton
    width: 100
    height: 28
    margin-top: 6
    color: white
    background-color: #d3452e
    visible: false

PartyInviteRow < Panel
  height: 40
  margin-left: 20
  margin-right: 20
  layout: horizontalBox

  Label
    id: name
    width: 300
    height: 40
    text-auto-resize: true
    text-align: left
    color: white
    font: verdana-11px-rounded

  ButtonBlueBase
    id: acceptButton
    !text: tr('Aceitar')
    width: 90
    height: 28
    color: white

  ButtonRedBase
    id: rejectButton
    !text: tr('Recusar')
    width: 90
    height: 28
    color: white
    background-color: #d3452e

PartySentInviteRow < Panel
  height: 40
  margin-left: 20
  margin-right: 20
  layout: horizontalBox

  Label
    id: name
    width: 390
    height: 40
    text-auto-resize: true
    text-align: left
    color: white
    font: verdana-11px-rounded

  ButtonRedBase
    id: cancelButton
    !text: tr('Cancelar')
    width: 120
    height: 28
    color: white
    background-color: #d3452e

PartyLootRow < Panel
  height: 28
  margin-left: 0
  margin-right: 0
  layout: horizontalBox

  Label
    id: name
    width: 135
    height: 28
    text-auto-resize: false
    text-align: left
    color: white
    font: verdana-11px-rounded

  Label
    id: loot
    width: 70
    height: 28
    text-auto-resize: false
    text-align: right
    color: #e0c060
    font: verdana-11px-rounded

  Label
    id: supply
    width: 70
    height: 28
    text-auto-resize: false
    text-align: right
    color: #a0c0ff
    font: verdana-11px-rounded

  Label
    id: damage
    width: 70
    height: 28
    text-auto-resize: false
    text-align: right
    color: #ff9b8a
    font: verdana-11px-rounded

  Label
    id: healing
    width: 70
    height: 28
    text-auto-resize: false
    text-align: right
    color: #9bffb0
    font: verdana-11px-rounded

PublicGroupRow < Panel
  height: 40
  margin-left: 20
  margin-right: 20
  layout: horizontalBox

  Label
    id: name
    width: 300
    height: 40
    text-auto-resize: true
    text-align: left
    color: white
    font: verdana-11px-rounded

  ButtonBlueBase
    id: actionButton
    !text: tr('Solicitar')
    width: 120
    height: 28
    color: white

MainWindow
  id: partyWindow
  text: Party
  size: 700 400
  @onEscape: self:hide()

  Panel
    id: creationPanel
    margin-top: 55
    anchors.fill: parent
    visible: true

    ButtonBlueBase
      id: createPrivateButton
      !text: tr('Criar Grupo Privado')
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 15
      margin-left: 20
      width: 180
      height: 40
      color: white
      @onClick: modules.game_party.createPrivateParty()

    ButtonBlueBase
      id: publicGroupsButton
      !text: tr('Abrir Grupos Publicos')
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 15
      margin-right: 20
      width: 180
      height: 40
      color: white
      @onClick: modules.game_party.openPublicGroups()

    Label
      id: invitesTitle
      !text: tr('Convites')
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 30
      font: verdana-11px-rounded
      text-auto-resize: true

    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 20
      margin-right: 20

    Panel
      id: invitesPanel
      anchors.top: prev.bottom
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      
      Panel
        id: invitesList
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        layout:
          type: verticalBox
        spacing: 5
      
      Label
        id: noInvitesLabel
        !text: tr('Nenhum convite')
        anchors.centerIn: parent
        text-align: center
        color: #888888
        font: verdana-11px-rounded

    Panel
      id: publicGroupsPanel
      anchors.fill: parent
      visible: false

      Label
        id: publicGroupsTitle
        !text: tr('Grupos Publicos')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10
        font: verdana-11px-rounded
        text-auto-resize: true

      ButtonBlueBase
        id: refreshPublicGroupsButton
        !text: tr('Atualizar')
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 6
        margin-left: 20
        width: 100
        height: 28

      ButtonRedBase
        id: closePublicGroupsButton
        !text: tr('Voltar')
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 6
        margin-right: 20
        width: 100
        height: 28
        background-color: #d3452e

      ScrollablePanel
        id: publicGroupsList
        anchors.top: publicGroupsTitle.bottom
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 10
        margin-bottom: 10
        layout:
          type: verticalBox
        spacing: 5

      Label
        id: noPublicGroupsLabel
        !text: tr('Nenhum grupo publico')
        anchors.centerIn: parent
        text-align: center
        color: #888888
        font: verdana-11px-rounded

  Panel
    id: managementPanel
    anchors.fill: parent
    margin-top: 55
    visible: false


    Panel
      id: sidebar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 100
      
      Label
        id: groupButton
        !text: tr('Grupo')
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 10
        margin-left: 10
        font: verdana-11px-rounded
        text-auto-resize: true
        color: white
      
      UIWidget
        id: groupIndicator
        anchors.top: groupButton.top
        anchors.bottom: groupButton.bottom
        anchors.left: groupButton.right
        margin-left: 10
        width: 3
        background-color: #3898fd

      Label
        id: lootButton
        !text: tr('Saque')
        anchors.top: groupButton.bottom
        anchors.left: parent.left
        margin-top: 15
        margin-left: 10
        font: verdana-11px-rounded
        text-auto-resize: true
        color: #888888

      Label
        id: detailsButton
        !text: tr('Detalhes')
        anchors.top: lootButton.bottom
        anchors.left: parent.left
        margin-top: 15
        margin-left: 10
        font: verdana-11px-rounded
        text-auto-resize: true
        color: #888888

      Label
        id: rechargesButton
        !text: tr('Recargas')
        anchors.top: detailsButton.bottom
        anchors.left: parent.left
        margin-top: 15
        margin-left: 10
        font: verdana-11px-rounded
        text-auto-resize: true
        color: #888888

      Label
        id: newGroupButton
        !text: tr('Novo Grupo')
        anchors.top: rechargesButton.bottom
        anchors.left: parent.left
        margin-top: 15
        margin-left: 10
        font: verdana-11px-rounded
        text-auto-resize: true
        color: #888888
  
    Panel
      id: contentArea
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: sidebar.right
      anchors.right: parent.right
      margin-left: 10
      
      ScrollablePanel
        id: membersList
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: leaveButton.top
        margin-bottom: 20
        vertical-scrollbar: membersListScrollBar
        layout:
          type: verticalBox
          spacing: 2

      VerticalScrollBar
        id: membersListScrollBar
        anchors.top: membersList.top
        anchors.bottom: membersList.bottom
        anchors.right: membersList.right
        step: 14
        pixels-scroll: true

      Panel
        id: lootPanel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: leaveButton.top
        margin-bottom: 20
        visible: false

        Panel
          id: lootHeader
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: lootListScrollBar.left
          margin-left: 10
          margin-right: 4
          height: 20
          layout:
            type: horizontalBox

          Label
            id: lootHeaderName
            !text: tr('Nome')
            width: 135
            height: 20
            text-align: left
            color: #888888
            font: verdana-11px-rounded

          Label
            id: lootHeaderLoot
            !text: tr('Loot')
            width: 70
            height: 20
            text-align: right
            color: #888888
            font: verdana-11px-rounded

          Label
            id: lootHeaderSupply
            !text: tr('Suprimento')
            width: 70
            height: 20
            text-align: right
            color: #888888
            font: verdana-11px-rounded

          Label
            id: lootHeaderDamage
            !text: tr('Dano')
            width: 70
            height: 20
            text-align: right
            color: #888888
            font: verdana-11px-rounded

          Label
            id: lootHeaderHealing
            !text: tr('Cura')
            width: 70
            height: 20
            text-align: right
            color: #888888
            font: verdana-11px-rounded

        ScrollablePanel
          id: lootList
          anchors.top: lootHeader.bottom
          anchors.left: parent.left
          anchors.right: lootListScrollBar.left
          anchors.bottom: parent.bottom
          margin-left: 10
          margin-right: 4
          vertical-scrollbar: lootListScrollBar
          layout:
            type: verticalBox
            spacing: 2

        VerticalScrollBar
          id: lootListScrollBar
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          step: 14
          pixels-scroll: true

      ButtonRedBase
        id: leaveButton
        !text: tr('Sair do Grupo')
        anchors.bottom: footerOptions.top
        anchors.left: parent.left
        margin-bottom: 20
        margin-left: 20
        width: 120
        height: 30
        color: white
        background-color: #d3452e
        @onClick: modules.game_party.leaveParty()
      
      ButtonBlueBase
        id: invitePlayerButton
        !text: tr('Adicionar Membro')
        anchors.top: leaveButton.top
        anchors.left: leaveButton.right
        margin-left: 10
        width: 130
        height: 30
        color: white
        @onClick: modules.game_party.invitePlayer()

      ButtonBlueBase
        id: publicGroupButton
        !text: tr('Publicar Grupo')
        anchors.top: leaveButton.top
        anchors.left: invitePlayerButton.right
        margin-left: 10
        width: 130
        height: 30
        color: white
        @onClick: modules.game_party.togglePublicGroup()

      Panel
        id: footerOptions
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 60
      
        UIWidget
          id: lootIcon
          image-source: /images/profile/icon_lock
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          margin-bottom: 30
          margin-left: 20
          size: 16 16
          
        Label
          id: lootLabel
          !text: tr('Saque')
          anchors.left: lootIcon.right
          anchors.verticalCenter: lootIcon.verticalCenter
          margin-left: 5
          font: verdana-11px-rounded
          
        Label
          id: lootValue
          !text: tr('Compartilhado')
          anchors.top: lootIcon.bottom
          anchors.left: lootIcon.left
          margin-top: 5
          font: verdana-11px-rounded
          color: #888888

        UIWidget
          id: expIcon
          image-source: /images/profile/icon_lock
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          margin-bottom: 30
          margin-left: 150
          size: 16 16
          
        Label
          id: expLabel
          !text: tr('Experi??ncia')
          anchors.left: expIcon.right
          anchors.verticalCenter: expIcon.verticalCenter
          margin-left: 5
          font: verdana-11px-rounded
          
        Label
          id: expValue
          !text: tr('Compartilhado')
          anchors.top: expIcon.bottom
          anchors.left: expIcon.left
          margin-top: 5
          font: verdana-11px-rounded
          color: #888888

        UIWidget
          id: taskIcon
          image-source: /images/profile/icon_lock
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          margin-bottom: 30
          margin-left: 300
          size: 16 16
          
        Label
          id: taskLabel
          !text: tr('Tarefa')
          anchors.left: taskIcon.right
          anchors.verticalCenter: taskIcon.verticalCenter
          margin-left: 5
          font: verdana-11px-rounded
          
        Label
          id: taskValue
          !text: tr('Sequ??ncia')
          anchors.top: taskIcon.bottom
          anchors.left: taskIcon.left
          margin-top: 5
          font: verdana-11px-rounded
          color: #888888


