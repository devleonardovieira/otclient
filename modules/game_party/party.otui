    size: 138 17

  UILabel
    id: valueUlti
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    font: verdana-11px-rounded
    size: 138 17
    margin-bottom: 20
    margin-left: 75
    text-align: center
    phantom: true

  UIWidget
    id: icon
    image-source: /images/profile/playerIconHolder
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 15
    margin-left: 65
