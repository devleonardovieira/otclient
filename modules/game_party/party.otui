    margin-top: 19
    margin-left: 78
    image-color: #d3452e
    phantom: true

  UILabel
    id: valueHp
    anchors.left: parent.left
    anchors.top: parent.top
    font: verdana-11px-rounded
    size: 166 29
    margin-top: 19
    margin-left: 78
    text-align: center
    phantom: true

  UIWidget
    id: manaBar
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    image-source: /images/profile/playerManaFill
    margin-bottom: 36
    margin-left: 87
    image-color: #3898fd
    phantom: true

  UILabel
    id: valueMana
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    font: verdana-11px-rounded
    size: 139 26
    margin-bottom: 36
    margin-left: 87
    text-align: center
    phantom: true

  UIWidget
    image-source: /images/profile/playerBar
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    size: 138 17
    margin-bottom: 20
    margin-left: 75
    phantom: true

  UIWidget
    id: ultiBar
    anchors.left: parent.left
    anchors.bottom: parent.bottom
