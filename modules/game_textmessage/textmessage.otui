TextMessageLabel < UILabel
  font: verdana-11px-rounded
  text-align: center
  text-wrap: true
  text-auto-resize: true
  margin-bottom: 2
  visible: false

Panel
  anchors.fill: gameMapPanel
  focusable: false

  Panel
    id: centerTextMessagePanel
    layout:
      type: verticalBox
      fit-children: true
    width: 360
    anchors.centerIn: parent

    TextMessageLabel
      id: highCenterLabel
    TextMessageLabel
      id: middleCenterLabel
    TextMessageLabel
      id: lowCenterLabel

  TextMessageLabel
    id: privateLabel
    anchors.top: parent.top
    anchors.bottom: centerTextMessagePanel.top
    anchors.horizontalCenter: parent.horizontalCenter
    text-auto-resize: false
    width: 275

  TextMessageLabel
    id: statusLabel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  PanelRounded
    id: statusBubble
    visible: false
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 85
    padding: 8
    image-border: 20
    size: 280 0
    layout:
      type: verticalBox
      fit-children: true
      spacing: 6

    ProgressBar
      id: cooldownBar
      height: 4
      background-color: #1fbf6e
      background-border: 0
      width: 264
      

    Label
      id: bubbleText
      text: ""
      color: #FFDA2B
      width: 264
      text-align: center
      text-wrap: true
      text-auto-resize: true
      text-vertical-auto-resize: true
      text-offset: 2 0
      
