EmoteWheel < UIWidget
  id: emoteWheel
  size: 512 512
  anchors.centerIn: parent
  visible: false
  phantom: true

  UIWidget
    id: wheel
    anchors.fill: parent
    phantom: false

    UIWidget
      id: wheelBg
      anchors.fill: parent
      image-source: /images/emotes/wheel_bg
      opacity: 0.5
      phantom: true

    UIWidget
      id: icons
      anchors.fill: parent
      phantom: false

  UILabel
    id: indicator
    anchors.centerIn: parent
    margin-top: 60
    color: #ffffff
    text-align: center
