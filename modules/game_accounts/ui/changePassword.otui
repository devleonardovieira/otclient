PasswordChangeWindow < MainHeadlessWindow
  id: window
  size: 439 380
  !text: tr('Change Password')

  Label-14px-Medium
    anchors.top: parent.top
    anchors.left: parent.left
    text-auto-resize: true
    !text: tr('Old password')

  TextEdit
    id: oldPasswordInput
    anchors.top: prev.bottom
    anchors.left: prev.left
    anchors.right: parent.right
    margin-top: 4
    @onTextChange: |
      function(self, text)
        if ( onInputRequired(self) ) then
          onInputSuccess(self)
        end
      end

  Label-13px-Regular
    id: helperOldPasswordInput
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    text-wrap: true
    margin-top: 2

  Label-14px-Medium
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    margin-top: 8
    !text: tr("New password")

  TextEditPassword
    id: passwordInput
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    @onTextChange: |
      function(self, text)
        onInputPassword(self)
        onInputConfirmPassword(self, self:getParent().confirmPasswordInput)
      end

  Label-13px-Regular
    id: helperPasswordInput
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    text-wrap: true
    margin-top: 2

  Label-14px-Medium
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    margin-top: 8
    !text: tr("Confirm new password")

  TextEditPassword
    id: confirmPasswordInput
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    @onTextChange: |
      function(self, text)
        onInputConfirmPassword(self:getParent().passwordInput, self)
      end

  Label-13px-Regular
    id: helperConfirmPasswordInput
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    text-wrap: true
    margin-top: 2

  ButtonBlueSmall
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    margin-right: 5
    !text: tr('Confirm')
    @onClick: modules.game_accounts.onChangePassword()

  ButtonRedSmall
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    anchors.left: parent.horizontalCenter
    margin-left: 5
    !text: tr('Cancel')
    @onClick: modules.game_accounts.hidePasswordChangePanel()

ChangePasswordPanel < UIWidget
  anchors.fill: parent
  background-color: #000000CC

  PasswordChangeWindow
    anchors.centerIn: parent