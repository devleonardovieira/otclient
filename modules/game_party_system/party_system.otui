PartySidebarButton < UIButton
  height: 32
  margin-bottom: 2
  color: #888888
  font: verdana-11px-monochrome
  text-align: left
  text-offset: 10 0
  background-color: alpha

  $hover:
    color: #ffffff
    background-color: #ffffff22

  $checked:
    color: #ffffff
    background-color: #ffffff44
    border-left: 2 #3898fd

PartyMemberAvatar < UIWidget
  size: 64 80
  margin: 5
  
  UIWidget
    id: status
    size: 8 8
    image-source: /images/game/party/common_green
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 5
    margin-left: 5
  
  UIWidget
    id: leader
    size: 12 12
    image-source: /images/game/party/icon_leader
    anchors.top: parent.top
    anchors.left: status.right
    margin-left: 2
    margin-top: 3
    visible: false

  Label
    id: name
    anchors.top: parent.top
    anchors.left: leader.right
    anchors.right: parent.right
    margin-left: 2
    text-align: center
    text-auto-resize: true
    color: #00eb00

  UICreature
    id: outfit
    anchors.top: name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    size: 48 48
    margin-top: 5
    phantom: true

  UIProgressBar
    id: hpBar
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 4
    background-color: #444444
    margin-bottom: 2

PartyOptionComboBox < ComboBox
  height: 20
  font: verdana-11px-monochrome
  menu-scroll: true
  menu-height: 100
  menu-scroll-step: 20

PartyOptionComboBoxPopupMenu < ComboBoxPopupMenu
PartyOptionComboBoxPopupScrollMenu < ComboBoxPopupScrollMenu
PartyOptionComboBoxPopupScrollMenuButton < ComboBoxPopupScrollMenuButton

PartyDetailItem < UIWidget
  height: 20
  layout: horizontalBox

PartyRechargeItem < UIWidget
  height: 20
  layout: horizontalBox

MainWindow
  id: partySystemWindow
  size: 600 400
  anchors.centerIn: parent
  @onEscape: self:hide()
  
  UIWidget
    id: sidebar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 120
    margin-top: 30
    
    PartySidebarButton
      id: tabGroup
      text: Grupo
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      !checked: true

    PartySidebarButton
      id: tabLoot
      text: Saque
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right

    PartySidebarButton
      id: tabDetails
      text: Detalhes
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right

    PartySidebarButton
      id: tabRecharges
      text: Recargas
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right

    PartySidebarButton
      id: tabNewGroup
      text: Novo Grupo
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 20


  UIWidget
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: sidebar.right
    width: 1
    background-color: #333333
    margin-top: 30

  UIWidget
    id: content
    anchors.top: parent.top
    anchors.left: sidebar.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 30
    margin-left: 10
    margin-right: 10
    margin-bottom: 10

    UIWidget
      id: panelGroup
      anchors.fill: parent
      visible: true

      UIWidget
        id: membersArea
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 200
        layout:
          type: grid
          cell-size: 80 100
          cell-spacing: 5
          flow: true

      UIButton
        id: btnAddMember
        text: Adicionar Membro
        anchors.left: parent.left
        anchors.top: membersArea.bottom
        width: 140
        height: 30
        margin-top: 20
        color: white
        background-color: #4488ff

      UIButton
        id: btnLeaveDisband
        text: Dispersar Grupo
        anchors.left: btnAddMember.right
        anchors.top: membersArea.bottom
        width: 140
        height: 30
        margin-left: 10
        margin-top: 20
        color: white
        background-color: #ff4444

      UIWidget
        id: commonIcon
        anchors.right: parent.right
        anchors.top: membersArea.bottom
        margin-top: 25
        text: Common
        icon: /images/game/party/icon_common
        text-offset: 25 0


      UIWidget
        id: settingsArea
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 50
        
        Label
          text: Saque
          anchors.left: parent.left
          anchors.bottom: comboLoot.top
          margin-bottom: 2
          font: verdana-11px-rounded
          color: #ffaa00
          
        PartyOptionComboBox
          id: comboLoot
          anchors.left: parent.left
          anchors.bottom: parent.bottom
          width: 120
          
        Label
          text: Experiência
          anchors.left: comboLoot.right
          anchors.bottom: comboExp.top
          margin-left: 10
          margin-bottom: 2
          font: verdana-11px-rounded
          color: #ffaa00

        PartyOptionComboBox
          id: comboExp
          anchors.left: comboLoot.right
          anchors.bottom: parent.bottom
          margin-left: 10
          width: 120

        Label
          text: Tarefa
          anchors.left: comboExp.right
          anchors.bottom: comboTask.top
          margin-left: 10
          margin-bottom: 2
          font: verdana-11px-rounded
          color: #ffaa00

        PartyOptionComboBox
          id: comboTask
          anchors.left: comboExp.right
          anchors.bottom: parent.bottom
          margin-left: 10
          width: 120

    UIWidget
      id: panelLoot
      anchors.fill: parent
      visible: false

      Label
        text: Últimos Saques
        anchors.top: parent.top
        anchors.left: parent.left
        font: verdana-11px-rounded
        color: #ffaa00

      UIScrollArea
        id: lootList
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 5
        vertical-scrollbar: lootListScroll
        layout:
          type: verticalBox
          spacing: 2

      VerticalScrollBar
        id: lootListScroll
        anchors.top: lootList.top
        anchors.bottom: lootList.bottom
        anchors.right: lootList.right
        step: 14
        pixels-scroll: true

    UIWidget
      id: panelDetails
      anchors.fill: parent
      visible: false


      UIWidget
        id: detailsHeader
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 20

        Label
          text: Nome
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          width: 100
          font: verdana-11px-monochrome

        Label
          text: Nível
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          width: 50
          font: verdana-11px-monochrome

        Label
          text: Clã/Voc
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          width: 100
          font: verdana-11px-monochrome

      UIScrollArea
        id: detailsList
        anchors.top: detailsHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 5
        vertical-scrollbar: detailsListScroll
        layout:
          type: verticalBox
          spacing: 2

      VerticalScrollBar
        id: detailsListScroll
        anchors.top: detailsList.top
        anchors.bottom: detailsList.bottom
        anchors.right: detailsList.right
        step: 14
        pixels-scroll: true

    UIWidget
      id: panelRecharges
      anchors.fill: parent
      visible: false

      Label
        text: Suprimentos do Grupo
        anchors.top: parent.top
        anchors.left: parent.left
        font: verdana-11px-rounded
        color: #ffaa00

      UIScrollArea
        id: rechargesList
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 5
        vertical-scrollbar: rechargesListScroll
        layout:
          type: verticalBox
          spacing: 2

      VerticalScrollBar
        id: rechargesListScroll
        anchors.top: rechargesList.top
        anchors.bottom: rechargesList.bottom
        anchors.right: rechargesList.right
        step: 14
        pixels-scroll: true

    UIWidget
      id: panelNewGroup
      anchors.fill: parent
      visible: false

      UIButton
        id: btnCreatePrivate
        text: Criar Grupo Privado
        anchors.top: parent.top
        anchors.left: parent.left
        width: 180
        height: 40
        margin-top: 20
        margin-left: 20
        background-color: #4488ff
        color: white

      UIButton
        id: btnPublicGroups
        text: Abrir Grupos Públicos
        anchors.top: parent.top
        anchors.right: parent.right
        width: 180
        height: 40
        margin-top: 20
        margin-right: 20
        background-color: #4488ff
        color: white

      Label
        text: Convites
        anchors.top: btnCreatePrivate.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 30
        font: verdana-11px-rounded
        text-align: center

      UIWidget
        id: separator
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 1
        background-color: #555555
        margin-top: 5
        margin-left: 20
        margin-right: 20

      UIWidget
        id: invitesList
        anchors.top: separator.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 10
        
        Label
          id: noInvitesLabel
          text: Nenhum convite
          anchors.centerIn: parent
          color: #888888
