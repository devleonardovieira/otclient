ProfileTabButton < UIWidget
  height: 60
  background-color: #0b110e
  border-width: 1
  border-color: #1f2b24
  border-radius: 6
  
  $checked:
    background-color: #15221a
    border-color: #1fbf6e

  Label
    id: title
    font: verdana-9px-bold
    color: #555555
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8

  Label
    id: value
    font: verdana-16px-bold
    color: red
    anchors.centerIn: parent
    margin-top: 5

MissionRankCard < Panel
  background-color: #0b110e
  border-width: 1
  border-color: #1f2b24
  border-radius: 8
  
  Label
    id: rankTitle
    font: verdana-10px-bold
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15
    
  Label
    id: mainValue
    font: verdana-20px-bold
    color: #ffffff
    anchors.centerIn: parent
    margin-top: 5
    
  Label
    id: subValue
    font: verdana-12px-bold
    color: #555555
    anchors.left: mainValue.right
    anchors.bottom: mainValue.bottom
    margin-left: 2
    margin-bottom: 2
    
  UIWidget
    id: progressBar
    height: 3
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 15
    margin-right: 15
    margin-bottom: 15
    background-color: #333333

MainWindow
  id: profileWindow
  size: 900 650
  !text: tr('')
  @onEscape: modules.game_profile.profileController:toggle()
  padding: 0

  Panel
    id: headerPanel
    height: 140
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    
    UICreature
      id: portrait
      size: 72 72
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20
      padding: 4
      background-color: #000000
      border-width: 2
      border-color: #1fbf6e
      border-radius: 36

    Label
      id: levelBadge
      text: "42"
      color: #ffffff
      background-color: #1fbf6e
      size: 20 20
      border-radius: 10
      text-align: center
      font: verdana-11px-bold
      anchors.bottom: portrait.bottom
      anchors.right: portrait.right
      margin-bottom: 0
      margin-right: 0

    Label
      id: nameLabel
      text: "Kenji Zero"
      font: verdana-18px-bold
      color: #ffffff
      anchors.top: portrait.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10

    Label
      id: rankLabel
      text: "SHADOW WALKER"
      font: verdana-10px-bold
      color: #1fbf6e
      background-color: #15221a
      padding: 4 10
      border-radius: 4
      anchors.top: nameLabel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      text-auto-resize: true

    Label
      id: titleLabel
      text: "Master Assassin • Night Operative"
      font: verdana-11px-rounded
      color: #6a8c75
      anchors.top: rankLabel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5

  Panel
    id: tabBar
    height: 70
    anchors.top: headerPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 10
    margin-right: 10
    layout:
      type: horizontalBox
      spacing: 10

    ProfileTabButton
      id: tabMissions
      width: 170
      @onClick: modules.game_profile.profileController:selectTab('Missions')
      
      Label
        text: "S-RANK MISSIONS"
        font: verdana-9px-bold
        color: #555555
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 8
        
      Label
        id: missionValue
        text: "12"
        font: verdana-16px-bold
        color: #ffffff
        anchors.centerIn: parent
        margin-top: 5

    ProfileTabButton
      id: tabPvP
      width: 165
      @onClick: modules.game_profile.profileController:selectTab('PvP')
      
      Label
        text: "PVP KILLS"
        font: verdana-9px-bold
        color: #555555
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 8
        
      Label
        id: killsValue
        text: "27"
        font: verdana-16px-bold
        color: #ffffff
        anchors.centerIn: parent
        margin-top: 5

    ProfileTabButton
      id: tabBetrayals
      width: 170
      @onClick: modules.game_profile.profileController:selectTab('Betrayals')
      
      Label
        text: "BETRAYALS"
        font: verdana-9px-bold
        color: #8c5050
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 8
        
      Label
        id: betrayalValue
        text: "2"
        font: verdana-16px-bold
        color: #ff5555
        anchors.centerIn: parent
        margin-top: 5

    ProfileTabButton
      id: tabBank
      width: 165
      @onClick: modules.game_profile.profileController:selectTab('Bank')
      
      Label
        text: "BANK BALANCE"
        font: verdana-9px-bold
        color: #6a8c75
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 10
        margin-top: 8
        
      Label
        id: bankValue
        text: "¥1,400,000"
        font: verdana-16px-bold
        color: #ffffff
        anchors.centerIn: parent
        margin-top: 5
        
      UIWidget
        id: bankIcon
        size: 14 14
        image-source: /images/profile/icon-balance
        image-color: #1fbf6e
        anchors.top: parent.top
        anchors.right: parent.right
        margin-right: 10
        margin-top: 8

    ProfileTabButton
      id: tabSpecial
      width: 165
      @onClick: modules.game_profile.profileController:selectTab('Special')
      
      Label
        text: "SPECIAL"
        font: verdana-9px-bold
        color: #8c7a50
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 10
        margin-top: 8
        
      Label
        id: specialValue
        text: "850"
        font: verdana-16px-bold
        color: #e5bc6d
        anchors.centerIn: parent
        margin-top: 5
        
      UIWidget
        id: specialIcon
        size: 14 14
        image-source: /images/game/icons/icon_vip_32px
        image-color: #e5bc6d
        anchors.top: parent.top
        anchors.right: parent.right
        margin-right: 10
        margin-top: 8

  Panel
    id: contentPanel
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 10
    
    Panel
      id: contentMissions
      anchors.fill: parent
      visible: true
      
      ProfileCard
        id: missionLogCard
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 250
        
        UIWidget
          id: iconLog
          size: 4 14
          background-color: #1fbf6e
          anchors.top: parent.top
          anchors.left: parent.left
          margin-top: 2
          border-radius: 1
          
        Label
          text: "MISSION LOG"
          font: verdana-14px-bold
          color: #ffffff
          anchors.verticalCenter: iconLog.verticalCenter
          anchors.left: iconLog.right
          margin-left: 10
          
        Label
          id: totalCompleted
          text: "TOTAL COMPLETED: 342"
          font: verdana-9px-bold
          color: #555555
          anchors.verticalCenter: iconLog.verticalCenter
          anchors.right: parent.right
          
        Panel
          id: missionGrid
          anchors.top: iconLog.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin-top: 20
          layout:
            type: grid
            cell-size: 130 90
            cell-spacing: 15
            flow: true

    Panel
      id: contentPvP
      anchors.fill: parent
      visible: false
      
      UIWidget
        id: combatHeaderIcon
        size: 4 14
        background-color: #ff5555
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 2
        border-radius: 1
        
      Label
        text: "COMBAT RECORD"
        font: verdana-14px-bold
        color: #ffffff
        anchors.verticalCenter: combatHeaderIcon.verticalCenter
        anchors.left: combatHeaderIcon.right
        margin-left: 10
        
      Label
        text: "SEASON 5"
        font: verdana-10px-bold
        color: #555555
        anchors.verticalCenter: combatHeaderIcon.verticalCenter
        anchors.right: parent.right
        
      Panel
        id: statsRow
        height: 80
        anchors.top: combatHeaderIcon.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 20
        layout:
          type: horizontalBox
          spacing: 15

      Panel
        id: historyHeader
        height: 20
        anchors.top: statsRow.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 25
        
        Label
          id: title
          text: "RECENT ENCOUNTERS"
          font: verdana-10px-bold
          color: #555555
          anchors.centerIn: parent
          
        UIWidget
          height: 1
          background-color: #333333
          anchors.right: title.left
          anchors.left: parent.left
          anchors.verticalCenter: title.verticalCenter
          margin-right: 15
          
        UIWidget
          height: 1
          background-color: #333333
          anchors.left: title.right
          anchors.right: parent.right
          anchors.verticalCenter: title.verticalCenter
          margin-left: 15

      ScrollablePanel
        id: combatHistoryList
        anchors.top: historyHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 15
        vertical-scrollbar: combatHistoryListScrollBar
        layout:
          type: verticalBox
          spacing: 8

      VerticalScrollBar
        id: combatHistoryListScrollBar
        anchors.top: combatHistoryList.top
        anchors.bottom: combatHistoryList.bottom
        anchors.right: combatHistoryList.right
        step: 14
        pixels-scroll: true

    Panel
      id: contentBetrayals
      anchors.fill: parent
      visible: false
      
      Panel
        id: betrayalActions
        height: 80
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        layout:
          type: horizontalBox
          spacing: 15

      Label
        text: "BINGO BOOK"
        font: verdana-12px-bold
        color: #ff5555
        anchors.top: betrayalActions.bottom
        anchors.left: parent.left
        margin-top: 25

      Label
        text: "FILTER: S-RANK"
        font: verdana-10px-bold
        color: #ff5555
        anchors.verticalCenter: prev.verticalCenter
        anchors.right: parent.right

      UIWidget
        id: filterIcon
        size: 10 10
        image-source: /images/game/icons/icon_arrow
        image-color: #ff5555
        anchors.verticalCenter: prev.verticalCenter
        anchors.right: prev.left
        margin-right: 5
        rotation: 90

      Panel
        id: bingoBookGrid
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 15
        layout:
          type: grid
          cell-size: 280 90
          cell-spacing: 15
          flow: true

    Panel
      id: contentBank
      anchors.fill: parent
      visible: false
      
      Panel
        id: bankActions
        height: 80
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        layout:
          type: horizontalBox
          spacing: 15
          
      Label
        text: "HISTORY LOG"
        font: verdana-12px-bold
        color: #ffffff
        anchors.top: bankActions.bottom
        anchors.left: parent.left
        margin-top: 25
        
      Label
        text: "FILTER"
        font: verdana-10px-bold
        color: #1fbf6e
        anchors.verticalCenter: prev.verticalCenter
        anchors.right: parent.right
        
      UIWidget
        id: filterIcon
        size: 10 10
        image-source: /images/game/icons/icon_arrow
        image-color: #1fbf6e
        anchors.verticalCenter: prev.verticalCenter
        anchors.right: prev.left
        margin-right: 5
        rotation: 90

      Panel
        id: transactionList
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 15
        layout:
          type: verticalBox
          spacing: 10

    Panel
      id: contentSpecial
      anchors.fill: parent
      visible: false
      
      Label
        text: "VIP BENEFITS COMING SOON"
        anchors.centerIn: parent
        color: #555555

ProfileCard < Panel
  background-color: #0b110e
  border-width: 1
  border-color: #1f2b24
  border-radius: 6
  padding: 10

ProfileAffinityPanel < Panel
  height: 35
  
  UIWidget
    id: icon
    size: 20 20
    anchors.left: parent.left
    anchors.top: parent.top
    
  Label
    id: name
    font: verdana-11px-bold
    color: #cccccc
    anchors.left: icon.right
    anchors.top: parent.top
    margin-left: 8
    
  Label
    id: value
    font: verdana-10px-bold
    anchors.right: parent.right
    anchors.top: parent.top
    
  UIWidget
    id: progressBarBg
    height: 4
    background-color: #1f2b24
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.bottom: icon.bottom
    margin-left: 8
    border-radius: 2
    
  UIWidget
    id: progressBar
    height: 4
    anchors.left: progressBarBg.left
    anchors.top: progressBarBg.top
    border-radius: 2

ProfileFactionPanel < Panel
  height: 40
  background-color: #0b110e
  border-radius: 6
  padding: 8
  
  UIWidget
    id: icon
    size: 24 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    background-color: #15221a
    border-radius: 12
    padding: 4
    
  Label
    id: name
    font: verdana-11px-bold
    color: #ffffff
    anchors.top: parent.top
    anchors.left: icon.right
    margin-left: 10
    margin-top: 2
    
  Label
    id: desc
    font: verdana-9px-bold
    color: #555555
    anchors.top: name.bottom
    anchors.left: icon.right
    margin-left: 10
    margin-top: 2
    
  Label
    id: status
    font: verdana-9px-bold
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    padding: 4 8
    border-radius: 4
    background-color: #15221a

ProfileLineagePanel < Panel
  height: 25
  
  UIWidget
    id: icon
    size: 14 14
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-color: #ff5555
    
  Label
    id: label
    font: verdana-10px-bold
    color: #aaaaaa
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    
  Label
    id: value
    font: verdana-11px-bold
    color: #ffffff
    anchors.left: label.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    
  UIWidget
    id: arrow
    size: 12 12
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/game/actionbar/icon_arrow
    rotation: 270
    image-color: #555555

CombatStatCard < Panel
  height: 80
  background-color: #15221a
  border-width: 1
  border-color: #1f2b24
  border-radius: 12

  Label
    id: title
    font: verdana-9px-bold
    color: #888888
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15
    text-align: center

  Label
    id: value
    font: verdana-20px-bold
    color: #ffffff
    anchors.centerIn: parent
    margin-top: 5

  UIWidget
    id: underline
    height: 3
    width: 30
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 15
    background-color: #1fbf6e
    border-radius: 1

CombatMatchPanel < Panel
  height: 64
  background-color: #15221a
  border-width: 0
  border-radius: 6
  margin-bottom: 2
  
  UIWidget
    id: statusIndicator
    width: 4
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    background-color: #1fbf6e
    border-top-left-radius: 6
    border-bottom-left-radius: 6

  UIWidget
    id: levelBox
    size: 40 40
    anchors.left: statusIndicator.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    border-width: 1
    border-color: #1fbf6e
    border-radius: 4
    background-color: #15221a
    
    Label
      id: levelTitle
      text: "LVL"
      font: verdana-9px-bold
      color: #1fbf6e
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      
    Label
      id: levelValue
      text: "45"
      font: verdana-12px-bold
      color: #ffffff
      anchors.centerIn: parent
      margin-top: 5

  Label
    id: name
    font: verdana-11px-bold
    color: #ffffff
    anchors.top: parent.top
    anchors.left: levelBox.right
    margin-left: 14
    margin-top: 14

  Label
    id: location
    font: verdana-9px-bold
    color: #888888
    anchors.top: name.bottom
    anchors.left: levelBox.right
    margin-left: 14
    margin-top: 4

  Label
    id: outcomeLabel
    text: "VICTORY"
    font: verdana-10px-bold
    color: #1fbf6e
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 15
    margin-top: 14

  Label
    id: timeLabel
    text: "2m ago"
    font: verdana-9px-bold
    color: #888888
    anchors.top: outcomeLabel.bottom
    anchors.right: parent.right
    margin-right: 15
    margin-top: 4

  Label
    id: time
    font: verdana-9px-bold
    color: #555555
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10

FactionRelationCard < Panel
  height: 60
  background-color: #15221a
  border-width: 1
  border-color: #1f2b24
  border-radius: 6
  padding: 0
  
  UIWidget
    id: leftBorder
    width: 4
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    background-color: #1fbf6e
    border-top-left-radius: 6
    border-bottom-left-radius: 6

  UIWidget
    id: iconBg
    size: 32 32
    anchors.left: leftBorder.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    background-color: #0b110e
    border-radius: 4
    
  UIWidget
    id: icon
    size: 20 20
    anchors.centerIn: iconBg
    image-color: #ffffff

  Label
    id: name
    font: verdana-11px-bold
    color: #ffffff
    anchors.top: parent.top
    anchors.left: iconBg.right
    margin-left: 12
    margin-top: 12

  Label
    id: details
    font: verdana-9px-bold
    color: #888888
    anchors.top: name.bottom
    anchors.left: iconBg.right
    margin-left: 12
    margin-top: 2

  Label
    id: status
    font: verdana-9px-bold
    padding: 2 6
    border-radius: 3
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 12
    margin-top: 12
    text-align: center

  Label
    id: sideNote
    font: verdana-9px-bold
    color: #555555
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 12
    margin-bottom: 12

LineageCard < Panel
  height: 70
  background-color: #0b110e
  border-width: 1
  border-color: #1f2b24
  border-radius: 10
  
  UIWidget
    id: iconBg
    size: 40 40
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 15
    background-color: #000000
    border-radius: 20
    border-width: 1
    border-color: #333333

  UIWidget
    id: icon
    size: 24 24
    anchors.centerIn: iconBg
    
  Label
    id: type
    font: verdana-9px-bold
    color: #ff5555
    anchors.top: parent.top
    anchors.left: iconBg.right
    margin-left: 15
    margin-top: 15
    text-transform: uppercase

  Label
    id: name
    font: verdana-14px-bold
    color: #ffffff
    anchors.top: type.bottom
    anchors.left: iconBg.right
    margin-left: 15
    margin-top: 2

  Label
    id: bonus
    font: verdana-9px-bold
    color: #888888
    anchors.top: name.bottom
    anchors.left: iconBg.right
    margin-left: 15
    margin-top: 2

  UIWidget
    id: arrow
    size: 16 16
    image-source: /images/game/icons/icon_arrow
    image-color: #555555
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 15
    rotation: 90

BankActionButton < UIWidget
  height: 80
  background-color: #15221a
  border-width: 1
  border-color: #1f2b24
  border-radius: 12
  
  UIWidget
    id: iconBg
    size: 32 32
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15
    background-color: #1f2b24
    border-radius: 16
    
  UIWidget
    id: icon
    size: 16 16
    anchors.centerIn: iconBg
    
  Label
    id: text
    font: verdana-11px-bold
    color: #ffffff
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 15

BankTransactionCard < Panel
  height: 60
  background-color: #15221a
  border-width: 1
  border-color: #1f2b24
  border-radius: 12
  padding: 10
  
  UIWidget
    id: iconBg
    size: 32 32
    background-color: #1f2b24
    border-radius: 16
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    
  UIWidget
    id: icon
    size: 16 16
    anchors.centerIn: iconBg
    
  Label
    id: title
    font: verdana-11px-bold
    color: #ffffff
    anchors.top: parent.top
    anchors.left: iconBg.right
    margin-left: 15
    margin-top: 8
    
  Label
    id: date
    font: verdana-10px-bold
    color: #888888
    anchors.bottom: parent.bottom
    anchors.left: iconBg.right
    margin-left: 15
    margin-bottom: 8
    
  Label
    id: amount
    font: verdana-12px-bold
    color: #ffffff
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 8
    
  Label
    id: detail
    font: verdana-9px-bold
    color: #555555
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 8

BingoBookCard < UIWidget
  height: 90
  background-color: #15221a
  border-width: 1
  border-color: #1f2b24
  border-radius: 12
  
  UIWidget
    id: avatar
    size: 50 50
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 15
    background-color: #0b110e
    border-width: 1
    border-color: #1f2b24
    
  Label
    id: name
    font: verdana-11px-bold
    color: #ffffff
    anchors.top: avatar.top
    anchors.left: avatar.right
    margin-left: 15
    
  Label
    id: rank
    font: verdana-10px-bold
    color: #ff5555
    anchors.top: name.bottom
    anchors.left: avatar.right
    margin-left: 15
    margin-top: 2
    
  Label
    id: bounty
    font: verdana-10px-bold
    color: #e5bc6d
