Panel
  id: background
  image-source: /images/background
  image-smooth: false
  image-fixed-ratio: true
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  margin-top: 1
  focusable: false

  UILabel
    id: clientVersionLabel
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    text-align: center
    text-auto-resize: true
    width: 120
    padding: 2
    color: #ffffff
    font: montserrat regularRounded 30

  UILabel
    id: alphaId
    text: ALPHA
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 18
    margin-right: 5
    text-align: center
    text-auto-resize: true
    width: 120
    padding: 2
    color: #ffffff
    font: montserrat semiboldRounded 30
    UILabel
      text: version 0.1a
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-bottom: -12
      margin-right: 1 
      font: montserrat mediumRounded 16
      text-auto-resize: true
      color: #36f991
      

  UIParticles
    id: particles
    effect: background-effect
    anchors.fill: parent
    phantom: true