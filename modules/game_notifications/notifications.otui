NotificationContainer < Panel
  anchors.top: parent.top
  anchors.right: parent.right
  margin-top: 12
  margin-right: 12
  size: 360 0
  layout:
    type: verticalBox
    fit-children: true

NotificationToast < Panel
  size: 360 0
  margin-bottom: 8
  padding: 8
  image-source: /images/ui/widget-borderimage
  image-border: 6
  border: 1 #000000
  opacity: 1
  phantom: false
  layout:
    type: verticalBox
    spacing: 6

  Panel
    id: row
    height: 56
    layout:
      type: horizontalBox
      spacing: 6

    UIWidget
      id: icon
      size: 24 24

    Panel
      id: content
      layout:
        type: verticalBox
      size: 312 56

      Label
        id: title
        text: ""
        color: #ffffff
        font: "verdana-11px-antialised"
        width: 312
        text-align: left
        text-wrap: true
        text-auto-resize: true
        text-vertical-auto-resize: true
        height: 18
        text-offset: 2 0

      Label
        id: message
        text: ""
        color: #dfdfdf
        font: "verdana-11px-antialised"
        width: 312
        text-align: left
        text-wrap: true
        text-auto-resize: true
        text-vertical-auto-resize: true
        height: 22
        margin-top: 2
        text-offset: 2 0

  ProgressBar
    id: timebar
    height: 4
    background-color: #44AD25
    background-border: 0
    width: 312
    margin-left: 30
    margin-top: 6
