NotificationContainer < Panel
  anchors.top: parent.top
  anchors.right: parent.right
  margin-top: 12
  margin-right: 12
  size: 360 0
  layout:
    type: verticalBox
    fit-children: true

NotificationToast < Panel
  size: 360 0
  margin-bottom: 8
  padding: 8
  image-source: /images/ui/widget-borderimage
  image-border: 6
  border: 1 #000000
  opacity: 1
  phantom: false
  layout:
    type: verticalBox
    spacing: 6

  Panel
    id: row
    layout:
      type: horizontalBox
      spacing: 6

    UIWidget
      id: icon
      size: 24 24

    Panel
      id: content
      layout:
        type: verticalBox
      size: 312 56

      UILabel
        id: title
        text: ""
        color: #ffffff
        font: "verdana-11px-rounded"
        width: 312
        text-wrap: true
        text-auto-resize: true

      UILabel
        id: message
        text: ""
        color: #dfdfdf
        font: "verdana-11px-rounded"
        width: 312
        text-wrap: true
        text-auto-resize: true

  ProgressBar
    id: timebar
    height: 4
    background-color: #44AD25
    background-border: 0
