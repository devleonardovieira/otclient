Item < UIItem
  size: 34 34
  image-source: /images/ui/item
  ttf-font: ReggaeOne-Regular|11
  color: white
  border: 0 white
  background-color: alpha

  $on:
    border: 1 #69B2CF

  $hover:
    border: 1 white
    background-color: #FFFFFF1A

  $disabled:
    color: #646464

UIDraggingItem < UIItem
  size: 34 34
  ttf-font: ReggaeOne-Regular|11
  border-color: alpha
  &draggingItem: true
  focusable: false
  phantom: true