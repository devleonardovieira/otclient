CityLabel < Panel
  size: 200 22

  Label-16px-Bold
    id: city
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    text-auto-resize: true
    stroke: 1 #000000
    phantom: false
    text: teste

  $hover:
    color: #1aa562

  $on:
    color: #1fbf6e

  UIButton
    id: icon
    size: 22 22
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/game/contracts/pin_map
    image-clip: 0 0 37 37
    margin-top: -2
    image-color: #FFFFFF
    change-cursor-image: true
    cursor: pointer
    @onHoverChange: |
      function(self, hovered)
        self:getParent().city:setOn(hovered)
      end

    $hover:
      image-color: #D1D1D1

MinimapFlag < UIWidget
  size: 11 11
  focusable: false

MinimapCross < UIWidget
  focusable: false
  phantom: true
  image: /images/game/minimap/cross
  size: 16 16

IconColorButton < UICheckBox
  size: 30 30
  border: 2 #3d3d3d
  anchors.left: prev.right
  anchors.top: prev.top
  margin-left: 6

  $!checked:
    border: 2 #3d3d3d

  $hover !checked:
    border: 2 white

  $checked:
    border: 2 white

MinimapButton < UIButton
  size: 24 24
  image-source: /images/game/icons/icons_map
  change-cursor-image: true
  cursor: pointer
  opacity: 0.7
  @onClick: addEvent(function() modules.game_minimap.setupControlPanels(self:getId()) end)

  $hover:
    opacity: 1

  $disabled:
    change-cursor-image: false

MinimapCloseButton < MinimapButton
  id: close
  icon-clip: 223 0 14 12
  !tooltip: tr('Close')

MinimapResetButton < MinimapButton
  id: reset
  image-clip: 0 72 24 24
  !tooltip: tr('Center')

MinimapFloorUpButton < MinimapButton
  id: floorUp
  image-clip: 0 0 24 24
  !tooltip: tr('Floor Up')

MinimapFloorDownButton < MinimapButton
  id: floorDown
  image-clip: 0 24 24 24
  !tooltip: tr('Floor Down')

MinimapZoomInButton < MinimapButton
  id: zoomIn
  image-clip: 0 48 24 24
  !tooltip: tr('Zoom In')

MinimapZoomOutButton < MinimapButton
  id: zoomOut
  image-clip: 0 96 24 24
  !tooltip: tr('Zoom Out')

// CheckBox estilizado para lista de filtros
FilterCheckBox < CheckBox
  image-source: /images/game/minimap/flagcheckbox
  image-size: 15 15
  image-border: 3
  margin-bottom: 6
  font: montserrat regular 14
  color: #EAEAEA
  text-auto-resize: true
  padding-left: 6

  $hover !checked:
    color: #FFFFFF

  $checked:
    color: #FFFFFF

MinimapFullButton < MinimapButton
  id: fullMapToggle
  image-clip: 0 120 24 24
  !tooltip: tr('Full map')
  @onClick: modules.game_minimap.toggleFullMap()

Minimap < UIMinimap
  draggable: true
  focusable: false
  cross: true

  Panel
    id: panelControls
    anchors.fill: parent
    visible: false
    border: 1 #444444

    ButtonClose
      anchors.top: parent.top
      anchors.right: parent.right
      @onClick: modules.game_minimap.toggleFullMap()

    MinimapFloorUpButton
      anchors.bottom: next.top
      anchors.left: next.left
      margin-bottom: 8

    MinimapFloorDownButton
      anchors.bottom: next.top
      anchors.left: next.left
      margin-bottom: 8

    MinimapZoomInButton
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter

    MinimapResetButton
      anchors.top: prev.bottom
      anchors.left: prev.left
      margin-top: 8

    MinimapZoomOutButton
      anchors.top: prev.bottom
      anchors.left: prev.left
      margin-top: 8
    // Painel direito do mapa completo (agora dentro de panelControls)
    Panel
      id: fullRightPanel
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 210
      image-source: /images/ui/panel
      margin-top: 25
      visible: false
      layout:
        type: verticalBox
        // não usar fit-children em painel ancorado (evita loop de layout)

      // Cabeçalho com modos
      Panel
        id: modesRow
        layout:
          type: horizontalBox
        margin-bottom: 6
        height: 26
        
      Label
        !text: tr('Modo:')
        font: montserrat regular 14
        color: #FFFFFF
        margin-right: 8

        CheckBox
          id: modeIcons
          !text: tr('Icon Viewer')
          checked: true
          @onCheckChange: |
            modules.game_minimap.onModeIconsChange(self:isChecked())

        CheckBox
          id: modeTeleports
          !text: tr('Teleports')
          margin-left: 16
          @onCheckChange: |
            modules.game_minimap.onModeTeleportsChange(self:isChecked())

      // Ações
      Panel
        id: actionsRow
        layout:
          type: horizontalBox
        margin-bottom: 6
        
        Label
          !text: tr('Ações:')
          font: montserrat regular 14
          color: #FFFFFF
          margin-right: 8

        ButtonBlueSmall
          id: clearAllButton
          !text: tr('Marcar Todos')
          @onClick: modules.game_minimap.clearAllFullMapFilters()

      

        Panel
          id: actionsDivider
          width: 1
          height: 16
          margin-left: 8
          background-color: #FFFFFF22

      // Lista de filtros
      Label
        !text: tr('Filtros')
        font: montserrat regular 14
        color: #FFFFFF
        margin-top: 8

      Panel
        id: filtersDivider
        width: parent.width
        height: 1
        margin-top: 4
        background-color: #FFFFFF18

      Panel
        id: filtersPanel
        margin-top: 8
        layout:
          type: verticalBox
          fit-children: true

        FilterCheckBox
          id: filter_player_markings
          !text: tr('Player Markings')
          checked: true

        FilterCheckBox
          id: filter_pokemon_center
          !text: tr('Pokemon Center')
          checked: true

        FilterCheckBox
          id: filter_fishing_spot
          !text: tr('Fishing Spot')
          checked: true

        FilterCheckBox
          id: filter_pokemon_buyer
          !text: tr('Pokemon Buyer')
          checked: true

        FilterCheckBox
          id: filter_npc_mark
          !text: tr('NPC - Mark')
          checked: true

        FilterCheckBox
          id: filter_npc_hugh
          !text: tr('NPC - Hugh')
          checked: true

        FilterCheckBox
          id: filter_npc_guru
          !text: tr('NPC - Guru')
          checked: true

        FilterCheckBox
          id: filter_npc_heather
          !text: tr('NPC - Heather')
          checked: true

        FilterCheckBox
          id: filter_furnitures_shop
          !text: tr('Furnitures Shop')
          checked: true

        FilterCheckBox
          id: filter_electronic_shop
          !text: tr('Electronic Shop')
          checked: true

        FilterCheckBox
          id: filter_mining_spot
          !text: tr('Mining Spot')
          checked: true

        FilterCheckBox
          id: filter_anvil
          !text: tr('Anvil')
          checked: true

        FilterCheckBox
          id: filter_furnace
          !text: tr('Furnace')
          checked: true
// Minimap Flag Create Window


MinimapFlagCheckBox < UICheckBox
  size: 34 34
  margin-left: 6
  icon-source: /images/game/minimap/mapflags
  border: 1 #3d3d3d
  anchors.left: prev.right
  anchors.top: prev.top

  $!checked:
    border: 1 #3d3d3d

  $hover !checked:
    border: 1 #c7c7c7

  $checked:
    border: 1 #c7c7c7

