MinimapWindow < MiniWindow
  height: 150
  image-source: /images/ui/panel
  border: 1 #3A3939

  MiniWindowContents
    margin: 2
    margin-right: 0

    Minimap
      id: minimap
      anchors.fill: parent
      color: #111111cc
      margin: 4

  MinimapFullButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 8

  MinimapFloorUpButton
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin: 0 0 16 5

  MinimapFloorDownButton
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin: 16 0 0 5

  MinimapZoomInButton
    anchors.bottom: next.bottom
    anchors.right: next.left
    margin-right: 8

  MinimapResetButton
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 8

  MinimapZoomOutButton
    anchors.bottom: prev.bottom
    anchors.left: prev.right
    margin-left: 8

  // Resize borders for the MiniWindow (right, left, top)
  ResizeBorder
    id: rightResizeBorder
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    enabled: true
    minimum: 164
    width: 3
    vertical: false
    opacity: 0
    background-color: transparent

  ResizeBorder
    id: leftResizeBorder
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    enabled: true
    minimum: 164
    inverted: true
    width: 5
    vertical: false
    opacity: 0
    background-color: transparent

  ResizeBorder
    id: topResizeBorder
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    enabled: true
    height: 5
    minimum: 100
    inverted: true
    vertical: true
    opacity: 0
    background-color: transparent
