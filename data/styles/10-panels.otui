Panel < UIWidget
  phantom: true
  auto-focus: first

ScrollablePanel < UIScrollArea
  phantom: true
  auto-focus: first

FlatPanel < Panel
  image-source: /images/ui/panel
  image-border: 1

ScrollableFlatPanel < ScrollablePanel
  image-source: /images/ui/panel
  image-border: 1

LightFlatPanel < Panel
  image-source: /images/ui/panel_lightflat
  image-border: 1

PanelRounded < Panel
  image-source: /images/ui/window
  image-border: 10

PanelOutline < Panel
  image-source: /images/ui/panel_outline
  image-clip: 0 180 170 60
  image-border: 14

PanelRoundedSolid < Panel
  image-source: /images/ui/panel_rounded_solid
  image-border: 10
