CheckBox < UICheckBox
  size: 24 24
  image-source: /images/ui/checkbox
  image-clip: 0 0 24 24
  image-rect: 0 0 24 24
  image-color: #CCCCCC
  text-auto-resize: true
  text-align: left
  text-offset: 29 3
  font: montserrat regularRounded 18
  color: #CCCCCC
  change-cursor-image: true
  cursor: pointer

  $hover !checked:
    image-clip: 0 0 24 24
    image-color: #FFFFFF
    color: #FFFFFF

  $checked:
    image-clip: 0 24 24 24
    image-color: #0466C8

  $hover checked:
    image-clip: 0 24 24 24
    image-color: #69B2FC
    color: #FFFFFF

  $disabled:
    change-cursor-image: false


ThickCheckBox < UICheckBox
  size: 18 18
  text-align: left
  text-offset: 18 0
  color: #dfdfdf
  image-color: #dfdfdfff
  image-rect: 0 0 12 12
  image-offset: 3 3
  image-source: /images/ui/checkbox-unchecked

  $hover !disabled:
    color: #ffffff

  $checked:
    image-source: /images/ui/checkbox-checked

  $hover checked:
    image-source: /images/ui/checkbox-checked

  $disabled:
    image-color: #dfdfdf88
    color: #dfdfdf88
    opacity: 0.8

ColorBox < UICheckBox
  size: 16 16
  image-color: #dfdfdfff
  image-source: /images/ui/colorbox

  $checked:
    image-clip: 16 0 16 16

  $!checked:
    image-clip: 0 0 16 16

ButtonBox < UICheckBox
  font: verdana-11px-antialised
  color: #dfdfdfff
  size: 106 23
  text-offset: 0 0
  text-align: center
  image-source: /images/ui/button
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3

  $hover !disabled:
    image-clip: 0 23 22 23

  $checked:
    image-clip: 0 46 22 23
    color: #dfdfdf

  $disabled:
    color: #dfdfdf88
    image-color: #dfdfdf88

ButtonBoxRounded < ButtonBox
  image-source: /images/ui/button_rounded

QtCheckBox < UICheckBox
  size: 14 14
  text-align: left
  text-offset: 18 1
  color: #dfdfdfff
  image-color: #dfdfdfff
  image-rect: 0 0 14 14
  image-source: /images/ui/newcheckbox

  $!checked:
    image-clip: 0 0 14 14

  $checked !disabled:
    image-clip: 0 13 14 14

  $checked disabled:
    image-clip: 0 26 14 14

fakeCheckBox < UICheckBox
  font: cipsoftFont
  size: 106 23
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  padding: 5 10 5 10
  opacity: 1.0
  color: #b9b9b9ff

  $hover !disabled:
    color: #ffffff

  $!checked:
    image-clip: 0 0 22 23

  $hover !checked:
    image-clip: 0 0 22 23

  $checked:
    image-clip: 0 46 22 23

  $hover checked:
    image-clip: 0 46 22 23

  $disabled:
    image-color: #dfdfdf88
    color: #dfdfdf88
    opacity: 0.8

CheckBoxButton < UICheckBox
  size: 106 23
  image-source: /images/ui/button-9grid-idle
  image-border: 3
  text-align: center
  padding: 5 10 5 10
  change-cursor-image: true
  cursor: pointer
  color: #BDBDBD
  $checked:
    image-source: /images/ui/button-9grid-pressed
    text-offset: 1 1
  $!checked:
    text-offset: 0 0
  $disabled:
    color: #dfdfdf88
    opacity: 0.8
    change-cursor-image: false
