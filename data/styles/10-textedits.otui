TextEdit < UITextEdit
  size: 280 40
  opacity: 1
  text-offset: 0 6
  color: #FFFFFF
  border: 2 #444444
  cursor-color: #FFFFFF
  background-color: #242424
  font: montserrat regular 20
  padding: 10 5 4 8
  selection-color: #3C3C3C
  selection-background-color: #dfdfdf
  change-cursor-image: true

  $disabled:
    background-color: #7D7D7D
    change-cursor-image: false

TextEditPassword < TextEdit
  text-hidden: true

MultilineTextEdit < TextEdit
  multiline: true
