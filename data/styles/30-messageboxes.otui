MessageBoxWindow < MainHeadlessWindow
  padding-top: 48
  font: montserrat bold 16

MessageBoxLabel < Label-16px-Regular
  id: messageBoxLabel
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter
  text-auto-resize: true
  text-align: center
  text-wrap: true
  color: #FFDA2B

MessageBoxButtonHolder < UIWidget
  id: buttonHolder
  margin-top: 18
  anchors.bottom: parent.bottom

ItemMessageBoxButtonHolder < MessageBoxButtonHolder
  margin-top: 32

MessageBoxButtonBlue < ButtonBlueSmall
  margin-left: 12

MessageBoxButtonRed < ButtonRedSmall
  margin-left: 12