ComboBoxPopupScrollMenuButton < UIButton
  height: 40
  background-color: #242424
  border: 1 #444444
  text-align: left
  text-offset: 10 0
  color: #FFFFFF
  font: montserrat bold 13

  $hover !disabled:
    background-color: #69B2FC
    border: 0 #444444

ComboBoxPopupScrollMenu < UIPopupScrollMenu
  height: 40

ComboBox < UIComboBox
  size: 200 40
  image-source:  /images/ui/combobox
  image-clip: 0 0 400 40
  image-border: 40
  text-align: left
  text-offset: 10 0
  font: montserrat bold 13

  $hover !disabled:
    image-clip: 0 40 400 40

  $on:
    image-clip: 0 80 400 40

  $on hover:
    image-clip: 0 120 400 40

ComboBoxPopupMenu < UIPopupMenu
  height: 40

ComboBoxPopupMenuButton < UIButton
  height: 40
  background-color: #242424
  border: 1 #444444
  text-align: left
  text-offset: 10 0
  color: #FFFFFF
  font: montserrat regular 14

  $hover:
    background-color: #69B2FC
    border: 0 #444444
    color: #FFFFFF

ComboBoxPopupMenuIcon < UIWidget
  anchors.verticalCenter: parent.verticalCenter
  anchors.right: parent.right
  icon-align: right
  phantom: true
  margin-right: 4

ComboBoxPopupMenuShortcutLabel < UILabel
  font: montserrat regular 12
  color: #FFFFFF
  text-align: right
  anchors.fill: parent
  margin: 1 8 0 5

ComboBoxPopupScrollMenuShortcutLabel < UILabel
  font: montserrat regular 12
  color: #FFFFFF
  text-align: right
  anchors.fill: parent
  margin: 1 8 0 5

ComboBoxPopupScrollMenuIcon < UIWidget
  anchors.verticalCenter: parent.verticalCenter
  anchors.right: parent.right
  icon-align: right
  phantom: true
  margin-right: 4

ComboBoxGamePopupScrollMenuButton < UIButton
  height: 40
  background-color: #0466C8
  text-align: left
  text-offset: 10 0
  color: #FFFFFF
  font: montserrat bold 13

  $hover !disabled:
    background-color: #69B2FC

ComboBoxGamePopupScrollMenu < UIPopupScrollMenu
  height: 40

ComboBoxGame < UIComboBox
  size: 200 40
  image-source:  /images/ui/combobox_game
  image-clip: 0 0 400 40
  image-border: 40
  text-align: left
  text-offset: 10 0
  font: montserrat bold 13
  &isGame: true

  $hover !disabled:
    image-clip: 0 40 400 40

  $on:
    image-clip: 0 80 400 40

  $on hover:
    image-clip: 0 120 400 40

ComboBoxGamePopupMenu < UIPopupMenu
  height: 40

ComboBoxGamePopupMenuButton < UIButton
  height: 40
  background-color: #0466C8
  text-align: left
  text-offset: 10 0
  color: #FFFFFF
  font: montserrat bold 13

  $hover !disabled:
    background-color: #69B2FC