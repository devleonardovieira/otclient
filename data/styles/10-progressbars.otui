ProgressBar < UIProgressBar
  height: 16
  background-color: red
  ttf-font: ReggaeOne-Regular|12
  text-offset: 0 1
  border: 1 #394042

  $!on:
    visible: false
    margin-top: 0
    margin-bottom: 0
    height: 0

LifeProgressBar < UIProgressBar
  height: 16
  background-color: green
  border: 1 black
  ttf-font: ReggaeOne-Regular|12
  text-offset: 0 2
  margin: 2
  
ProgressRect < UIProgressRect
  anchors.fill: parent
  phantom: true
  color: white
  background-color: #00000088
  ttf-font: ReggaeOne-Regular|12

HealthBar < ProgressBar
  background-color: #ff4444

ManaBar < ProgressBar
  background-color: #4444ff
