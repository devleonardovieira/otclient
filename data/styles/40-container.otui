PageButton < UIButton
  size: 30 18
  margin: 1


ContainerWindow < MiniWindow
  height: 160
  &save: true
  &containerWindow: true

  UIItem
    id: containerItemWidget
    virtual: true
    size: 18 18
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 5 0 0 6

  UIButton
    id: upButton
    anchors.top: lockButton.top
    anchors.right: lockButton.left
    margin-right: 4
    size: 18 18
    image-source: /images/game/miniwindow/up
    change-cursor-image: true
    cursor: pointer
    //image-color: #d4d4d4

    $hover:
      //image-color: #ffffff

    $pressed:
      //image-color: #cccccc

  Panel
    id: pagePanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: miniwindowTopBar.bottom
    margin: 1 3 0 3
    height: 24
    
    $on:
      visible: true

    $!on:
      visible: false

    Label-14px-Regular
      id: pageLabel
      anchors.centerIn: parent
      text-auto-resize: true

    ButtonPrevious
      id: prevPageButton
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left

    ButtonNext
      id: nextPageButton
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right

  MiniWindowContents
    padding: 2
    padding-right: 4
    //border: 1 white
    layout:
      type: grid
      cell-size: 32 32
      cell-spacing: 2
      flow: true
