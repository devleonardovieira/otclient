game
  sprite-size: 32
  last-supported-version: 1511
  draw-typing: false
  typing-icon: /images/game/console/typing
  
  map
    viewport: 17 9
    max-z: 15
    sea-floor: 7
    underground-floor: 8
    aware-underground-floor-range: 2

  tile
    max-elevation: 24
    max-things: 10
    transparent-floor-view-range: 2
    player-cover-auto-transparency: true
    player-cover-auto-transparency-opacity: 0.45

  creature
    draw-information-by-widget-beta: false
    force-new-walking-formula: true
    shield-blink-ticks: 500
    volatile-square-duration: 1000
    adjust-creature-information-based-crop-size: true
    use-crop-size-for-ui-draw: true
    diagonal-walk-speed: 2

  player
    diagonal-walk-speed: 2

  render
    invisible-ticks-per-frame: 75
    item-ticks-per-frame: 75
    effect-ticks-per-frame: 75
    missile-ticks-per-frame: 75
    animated-text-duration: 1000
    static-duration-per-character: 60
    min-static-text-duration: 3000

font
  animated-text: ReggaeOne-Regular|12
  static-text: ReggaeOne-Regular|12
  animated-text: game|20|0.3|gray
  creature-text: ReggaeOne-Regular|20|1|red
